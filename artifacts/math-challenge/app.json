{
  "expo": {
    "name": "QANAKAGON",
    "slug": "qanakagon",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/qanakagon-lightning.png",
    "splash": {
      "image": "./assets/images/qanakagon-lightning.png",
      "resizeMode": "contain",
      "backgroundColor": "#123BDE"
    },
    "scheme": "qanakagon",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.qanakagon.app",
      "infoPlist": {
        "CFBundleDisplayName": "Qanakagon",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.qanakagon.app"
    },
    "web": {
      "favicon": "./assets/images/qanakagon-lightning.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/qanakagon-lightning.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#123BDE",
          "dark": {
            "image": "./assets/images/qanakagon-lightning.png",
            "backgroundColor": "#123BDE"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "7f38ac13-fe06-4878-830d-f655d67842d6"
      }
    },
    "owner": "roysamtharakan"
  }
}
