{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "app:start": "pnpm --filter @workspace/math-challenge run dev",
    "app:tunnel": "pnpm --filter @workspace/math-challenge run dev:tunnel",
    "app:web": "pnpm --filter @workspace/math-challenge run dev:web",
    "app:test": "pnpm --filter @workspace/math-challenge run test"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.3"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
